# Copy this file to .env.local and fill in. Nothing here is committed.

# --- TMDB (required) ------------------------------------------------------
# The catalog: posters, cast, crew, ratings, streaming availability.
# Get one free at themoviedb.org → Settings → API. Either works; v4 preferred.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# --- Supabase (optional) --------------------------------------------------
# Auth and persistence. Without these the app still runs — auth is hidden and
# every page stays public. Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Discord (optional) ---------------------------------------------------
# Server ID and invite are public by design — the widget endpoint serves them
# to anyone once the server owner enables the widget.
# Server Settings → Engagement → Widget.
NEXT_PUBLIC_DISCORD_SERVER_ID=
NEXT_PUBLIC_DISCORD_INVITE=

# This one IS a credential: anyone holding it can post to the channel.
# Server Settings → Integrations → Webhooks. Never prefix with NEXT_PUBLIC.
DISCORD_WEBHOOK_URL=

# Canonical origin for links the app builds about itself (invite links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Needed for in-app account deletion (App Store 5.1.1(v)) —
# deleting an auth user requires admin rights the public key does not have.
# Supabase → Project Settings → API Keys → service_role. NEVER NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# APNs — push notifications. Key from developer.apple.com → Keys.
# APNS_KEY holds the .p8 contents (newlines escaped as \n) for hosting;
# APNS_KEY_PATH is the local-development alternative.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.couchcinemacollective.app
APNS_KEY=
APNS_KEY_PATH=
