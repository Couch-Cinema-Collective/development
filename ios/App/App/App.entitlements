<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications. "development" is correct to commit: Xcode swaps it
	  for "production" automatically when archiving against a distribution
	  profile, so this file works for both local device testing and the
	  App Store build.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Native Sign in with Apple (src/lib/native-auth.ts). The App ID in the
	     developer portal must have the capability enabled too — Xcode's
	     Signing & Capabilities tab does both when automatic signing is on. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
