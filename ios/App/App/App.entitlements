<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications. "development" is correct to commit: Xcode swaps it
	  for "production" automatically when archiving against a distribution
	  profile, so this file works for both local device testing and the
	  App Store build.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
